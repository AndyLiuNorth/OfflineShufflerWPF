<UserControl x:Class="ShufflerWPF.SingleTon.TopStackUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ShufflerWPF.SingleTon"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="820">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Rectangle Grid.Row="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="WhiteSmoke" Offset="1"/>
                    <GradientStop Color="WhiteSmoke"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="CancelButton" 
                    Style="{StaticResource ButtonMyStyle}" 
                    HorizontalAlignment="Center" 
                    IsTabStop="False"  
                    Content="Return" 
                    Margin="15,5,5,5" 
                    Height="25" 
                    Width="100" 
                    Click="CancelButton_Click" 
                    ToolTip="Cancel" 
                    Cursor="Hand">
            </Button>
            <Label VerticalAlignment="Center" Content="Staff ID:" FontSize="20"></Label>
            <Label VerticalAlignment="Center" Content="{Binding Path=userid}" FontSize="20"></Label>
        </StackPanel>
    </Grid>
</UserControl>
