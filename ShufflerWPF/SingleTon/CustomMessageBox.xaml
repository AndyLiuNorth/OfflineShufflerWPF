<Window x:Class="ShufflerWPF.SingleTon.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ShufflerWPF.SingleTon"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
    <Border BorderBrush="#C7D0D8" BorderThickness="1" CornerRadius="5">
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="MediumAquamarine" Offset="1"/>
                        <GradientStop Color="MediumAquamarine"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Grid.Row="0" Orientation="Horizontal" >
                <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon x:Name="IconPack"
                                         Grid.Column="0"
                                         Width="70" Height="70" Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" FontSize="20" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
            
            <StackPanel x:Name="ButtonPanel" Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="15">
            </StackPanel>
        </Grid>
    </Border>
</Window>