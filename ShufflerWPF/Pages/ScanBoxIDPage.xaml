<Window x:Class="ShufflerWPF.Pages.ScanBoxIDPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ShufflerWPF.Pages"
        mc:Ignorable="d"
        Topmost="True"
        WindowStyle="None"              
        WindowState="Maximized"
        ResizeMode="NoResize"           
        ShowInTaskbar="False"            
        PreviewKeyDown="ScanIDPage_PreviewKeyDown"
        Title="ScanIDPage" WindowStartupLocation="CenterScreen" Height="250" Width="400">
    <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="66*"></RowDefinition>
            <RowDefinition Height="26*"></RowDefinition>
        </Grid.RowDefinitions>
         <Rectangle Grid.Row="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="MediumAquamarine" Offset="1"/>
                    <GradientStop Color="MediumAquamarine"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox  x:Name="ScanIdInput"
                      md:HintAssist.Hint="Please Scan Box ID"
                      Focusable="True"  
                      IsTabStop="True" 
                      FontSize="30"
                      Width="350"
            >
            </TextBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" 
                    Style="{StaticResource ButtonMyStyle}" 
                    HorizontalAlignment="Center" 
                    IsTabStop="False"  
                    Content="Cancel" 
                    Margin="15" 
                    Height="45" 
                    Width="100" 
                    Click="CancelButton_Click" 
                    ToolTip="Cancel" 
                    Cursor="Hand">
            </Button>
        </StackPanel>
    </Grid>
</Window>
