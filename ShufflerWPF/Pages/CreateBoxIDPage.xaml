<Window x:Class="ShufflerWPF.Pages.CreateBoxIDPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:control="clr-namespace:ShufflerWPF.SingleTon"
        xmlns:local="clr-namespace:ShufflerWPF.Pages"
        xmlns:local2="clr-namespace:ShufflerWPF.Model"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="DragMe"
        WindowStyle="None"
        Title="CreateIDPage" Height="460" Width="600">
    <Window.DataContext>
        <local2:CreateIDPageViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"></RowDefinition>
            <RowDefinition Height="65*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
            <RowDefinition Height="5*"></RowDefinition>
        </Grid.RowDefinitions>
       
        <Grid.Resources>
            <Style TargetType="Rectangle" BasedOn="{StaticResource WhiteRectangleStyle}" />
        </Grid.Resources>
        <Rectangle Grid.Row="0" />
        <Rectangle Grid.Row="1" />
        <Rectangle Grid.Row="2" />
        <Rectangle Grid.Row="3" />
        
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <control:TopStackUserControl />
        </StackPanel>
         <Border Grid.Row="1" Width="550" Margin="10" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="80*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                
                    <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Content="Table No. :" FontSize="16" Margin="2 10 2 10"></Label>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TableIDCombobox" 
                              ItemsSource="{Binding Path=TableIDList}"
                              SelectedItem="{Binding Path=SelectedTableId,Mode=TwoWay }"
                              Height="30" 
                              Width="390" 
                              FontSize="16" 
                              Margin="2 2 2 2">
                    </ComboBox>
                      <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Content="Card Color:" FontSize="16" Margin="2 10 2 10"></Label>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ColorType" 
                                  ItemsSource="{Binding Path=ColorType}"
                                  SelectedItem="{Binding Path=SelectedColorType,Mode=TwoWay }"
                                  Height="30" 
                                  Width="390" 
                                  FontSize="16" 
                                  Margin="2 2 2 2">
                        </ComboBox>
                    <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Content="Purpose:" FontSize="16" Margin="2 10 2 10"></Label>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="IsMain" 
                              ItemsSource="{Binding Path=IsMain}"
                              SelectedItem="{Binding Path=SelectedIsMain,Mode=TwoWay }"
                              Height="30" 
                              Width="390" 
                              FontSize="16" 
                              Margin="2 2 2 2">
                
                    </ComboBox>
                    <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Content="Max Uses:" FontSize="16" Margin="2 20 2 20"></Label>
                    <TextBox x:Name="MaxCount" 
                             Text = "{Binding Path=maxCount}"
                             Grid.Row="3" Grid.Column="1" 
                             HorizontalContentAlignment="Center" 
                             HorizontalAlignment="Left"  
                             PreviewTextInput="MaxCount_PreviewTextInput"
                             TextChanged="MaxCount_TextChanged"
                             Height="30" 
                             Width="100" 
                             FontSize="16" 
                             Margin="2">
                    </TextBox>
                </Grid>
            </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20 2 20 2">
            <Button Content="Submit" 
                    Command="{Binding CreateBoxCommand}"
                    ToolTip="Submit and print Box ID QRCode"
                    Style="{StaticResource ButtonMyStyle}"
                    >
            </Button>
        </StackPanel>
    </Grid>
</Window>
