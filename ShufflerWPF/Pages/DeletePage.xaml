<Window x:Class="ShufflerWPF.Pages.DeletePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ShufflerWPF.Pages"
        xmlns:local2="clr-namespace:ShufflerWPF.Model"
        mc:Ignorable="d"
        Topmost="True"
        WindowStyle="None"              
        WindowState="Maximized"
        ResizeMode="NoResize"           
        ShowInTaskbar="False"   
        PreviewKeyDown="DeleteIDPage_PreviewKeyDown"
        Title="DeletePage" Height="500" Width="800">
    <Window.DataContext>
        <local2:CreateIDPageViewModel></local2:CreateIDPageViewModel>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
        </Grid.RowDefinitions>
        <Rectangle Grid.Row="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="MediumAquamarine" Offset="1"/>
                    <GradientStop Color="MediumAquamarine"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox  x:Name="ScanIdInput"
                      md:HintAssist.Hint="Scan Box ID to Delete"
                      Focusable="True"  
                      IsTabStop="True" 
                      FontSize="25"
                      Width="350"
            >
            </TextBox>
        </StackPanel>
        <Border x:Name="TableBorder" Grid.Row="2" Width="650" Margin="5" Padding="5" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="70*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Content="Select below to delete:" FontSize="12" Margin="2 1 2 1"></Label>
                    <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Content="Table No. :" FontSize="16" Margin="2 10 2 10"></Label>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TableIDCombobox" 
                              ItemsSource="{Binding Path=TableIDList}"
                              SelectedItem="{Binding Path=SelectedTableId,Mode=TwoWay }"
                              Height="30" 
                              Width="390" 
                              FontSize="16" 
                              Margin="2 2 2 2">
                    </ComboBox>
                      <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Content="Card Color:" FontSize="16" Margin="2 10 2 10"></Label>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ColorType" 
                                  ItemsSource="{Binding Path=ColorType}"
                                  SelectedItem="{Binding Path=SelectedColorType,Mode=TwoWay }"
                                  Height="30" 
                                  Width="390" 
                                  FontSize="16" 
                                  Margin="2 2 2 2">
                        </ComboBox>
                    <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Content="Purpose:" FontSize="16" Margin="2 10 2 10"></Label>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="IsMain" 
                              ItemsSource="{Binding Path=IsMain}"
                              SelectedItem="{Binding Path=SelectedIsMain,Mode=TwoWay }"
                              Height="30" 
                              Width="390" 
                              FontSize="16" 
                              Margin="2 2 2 2">
                
                    </ComboBox>
                    <Button Grid.Row="4" Grid.Column="1" Content="Submit" 
                            HorizontalAlignment="Right"
                            Width="100" 
                            Height="30" 
                            Command="{Binding DeleteBoxCommand}"
                            ToolTip="Submit and print Box ID QRCode"
                            Style="{StaticResource ButtonMyStyle}"
                    >
                    </Button>
                </Grid>
            </Border>
        <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" 
                    Style="{StaticResource ButtonMyStyle}" 
                    HorizontalAlignment="Center" 
                    IsTabStop="False"  
                    Content="Cancel" 
                    Margin="15" 
                    Height="45" 
                    Width="100" 
                    Click="CancelButton_Click" 
                    ToolTip="Cancel" 
                    Cursor="Hand">
            </Button>
        </StackPanel>
    </Grid>
</Window>
