<Window x:Class="ShufflerWPF.Pages.ShuffleAutoPage"
        x:Name = "ShufflerAutoPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:control="clr-namespace:ShufflerWPF.SingleTon"
        xmlns:local="clr-namespace:ShufflerWPF.Pages"
        xmlns:local2="clr-namespace:ShufflerWPF.Model"
        mc:Ignorable="d"
        MouseLeftButtonDown="DragMe"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Title="ShuffleAutoPage" Height="620" Width="800">
    <Window.DataContext>
        <local2:ShufflerAutoPageViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="6*"></RowDefinition>
            <RowDefinition Height="35*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="60*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>
         
        <Grid.Resources>
            <Style TargetType="Rectangle" BasedOn="{StaticResource WhiteRectangleStyle}" />
        </Grid.Resources>
        <Rectangle Grid.Row="0" />
        <Rectangle Grid.Row="1" />
        <Rectangle Grid.Row="2" />
        <Rectangle Grid.Row="3" />
        <Rectangle Grid.Row="4" />
         
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
            <control:TopStackUserControl x:Name='TopStackHost'/>    
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal">
            <Label  Content="Status:Machine Auto Shuffle" Foreground="DarkBlue" FontSize="20" Margin="2 2 2 2"></Label>
            <Label  Content="{Binding Path=OneBoxModel.Statusdescreption}" Foreground="LightSeaGreen" FontSize="20" Margin="2 2 2 2"></Label>
        </StackPanel>
        <StackPanel Grid.Row="2" HorizontalAlignment="Left" Orientation="Horizontal">
            <Label  Content="Box Information" Foreground="Black" FontSize="12" Margin="60 5 0 0"></Label>
         </StackPanel>
        <Border Grid.Row="3" Width="700" Margin="1" Padding="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
            <Grid HorizontalAlignment="Center" Margin="10" Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Text="Domain: " FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding OneBoxModel.DomainUi}" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="18" Text="Table No.:" FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding OneBoxModel.tableId}" Margin="5"/>
                    
                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="18" Text="Card Color: " FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="18" Text="{Binding OneBoxModel.colortypeUi}" Margin="5"/>
            
                <TextBlock Grid.Row="0" Grid.Column="2" FontSize="18" Text="Purpose: " FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" FontSize="18" Text="{Binding OneBoxModel.IsMainUi}" Margin="5"/>
            
                <TextBlock Grid.Row="1" Grid.Column="2" FontSize="18" Text="Number of Uses: " FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="3" FontSize="18" Text="{Binding OneBoxModel.count}" Margin="5"/>

                <TextBlock Grid.Row="2" Grid.Column="2" FontSize="18" Text="Max Uses:" FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="2" Grid.Column="3" FontSize="18" Text="{Binding OneBoxModel.maxCount}" Margin="5"/>
            
            </Grid>
        </Border>
       
        <StackPanel Grid.Row="4" HorizontalAlignment="Left" Orientation="Horizontal">
            <Label  Content="Machine ID" Foreground="Black" FontSize="10" Margin="10 22 0 0"></Label>
            <Label  Content="Machine Information" Foreground="Black" FontSize="10" Margin="60 22 0 0"></Label>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <ListBox x:Name="ShufflerListBox" 
                     Width="100"
                     Background="MediumAquamarine"
                     Margin="10,1,10,10" 
                     ItemsSource="{Binding ShufflerStatusList}"
                     SelectedItem="{Binding SelectedShufflerStatus, Mode=TwoWay}"
                     SelectionChanged="ShufflerListBox_OnSelectionChanged">
            </ListBox>
            <Border Width="350" Margin="10,1,10,10"  Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid DataContext="{Binding SelectedShufflerStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                
                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="ID: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding ShufflerId}" Margin="3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="Machine Status: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding LastStatus}" Margin="3"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="IsShuffleCompleted: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding IsShuffleCompleted}" Margin="3"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="Counting: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding CardCount, StringFormat={}{0}/416}" Margin="3"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="Finished Counting: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding NumberOfCompletedShuffling}" Margin="3"/>
                    
                    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="Last Error Code: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding LastError}" Margin="3"/>
                    
                    <TextBlock Grid.Row="6" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="Last Warning Code: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding LastWarning}" Margin="3"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="16" HorizontalAlignment="Right" Text="CardCase Code: " FontWeight="Bold" Margin="3"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Text="{Binding CardCase}" Margin="3"/>


                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <Button x:Name="DoShuffleButton" 
                        Style="{StaticResource ButtonMyStyle}" 
                        FontSize="20"
                        HorizontalAlignment="Center" IsTabStop="False"  
                        Content="Start Auto Shuffling" 
                        Margin="20" 
                        Height="60"
                        Width="250" 
                        Click="DoShuffleButton_Click"
                        ToolTip="Start Machine Auto Shuffle" 
                        Cursor="Hand" >
                </Button>
                <!-- <Button x:Name="StopShuffleButton"  -->
                <!--         Style="{StaticResource ButtonMyStyle}"  -->
                <!--         FontSize="20" -->
                <!--         HorizontalAlignment="Center"  -->
                <!--         IsTabStop="False"   -->
                <!--         Content="Stop"  -->
                <!--         Margin="20"  -->
                <!--         Height="60"  -->
                <!--         Width="250"  -->
                <!--         Click="StopShuffleButton_Click"  -->
                <!--         ToolTip="Start Manual"  -->
                <!--         Cursor="Hand"> -->
                <!-- </Button> -->
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Vertical" HorizontalAlignment="Right">

        </StackPanel>
    </Grid>
</Window>
