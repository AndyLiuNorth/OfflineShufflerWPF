<Application x:Class="ShufflerWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ShufflerWPF"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design 基礎樣式 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />

                <!-- 主色與輔助色 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 自訂背景樣式 -->
            <Style x:Key="WhiteRectangleStyle" TargetType="Rectangle">
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="GhostWhite" Offset="1"/>
                            <GradientStop Color="GhostWhite"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 自訂按鈕樣式 -->
            <Style x:Key="ButtonMyStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="LightSeaGreen"/> <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="BorderBrush" Value="LightSeaGreen"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="MediumAquamarine"/> <!-- 滑鼠經過時背景色 -->
                        <Setter Property="BorderBrush" Value="#FF26C6DA"/> <!-- 滑鼠經過時外框色 -->
                        <Setter Property="Foreground" Value="GhostWhite"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="LightSeaGreen"/> <!-- 按下時背景色 -->
                        <Setter Property="BorderBrush" Value="MediumSpringGreen"/> <!-- 按下時外框色 -->
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 自訂按鈕樣式 2 -->
            <Style x:Key="ButtonSecondStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="LightSalmon"/>
                <Setter Property="Foreground" Value="LightSalmon"/> 
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Foreground" Value="AliceBlue"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="BorderBrush" Value="Orange"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="DarkOrange"/> <!-- 滑鼠經過時背景色 -->
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="DarkGoldenrod"/> <!-- 按下時背景色 -->
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
